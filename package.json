{
  "name": "bluesky-mod",
  "version": "1.0.0",
  "description": "A Bluesky moderation bot you run yourself. It owns a block list, takes orders by DM, and refuses to block people you follow.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.js",
    "dry-run": "DRY_RUN=true LOG_LEVEL=debug node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.js",
    "dev": "LOG_LEVEL=debug node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/index.js",
    "setup": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/setup.js",
    "test": "vitest run",
    "eval:intent": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/eval-intent.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@ai-sdk/openai": "^4.0.118",
    "@ai-sdk/openai-compatible": "^3.0.92",
    "@atproto/api": "^0.19.17",
    "ai": "^7.0.126",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
