# Copy to .env and fill in. Everything below "Optional" can stay as it is.
# Never commit .env: it holds the bot's password and your model key.

# ---- Required ----------------------------------------------------------------

# Your own account, the person the bot works for: a handle (you.bsky.social)
# or a DID. A handle is looked up once and the account it named is pinned, so
# if the handle ever moves to someone else the bot will not start.
MOD_OWNER_DID=

# The bot's account, a handle or a DID. Use a separate account, not yours.
MOD_IDENTIFIER=

# An app password for the BOT account, with "Allow access to your direct
# messages" ticked. Settings > Privacy and Security > App Passwords.
# A plain app password cannot read DMs and the bot will hear nothing.
MOD_APP_PASSWORD=

# The list the bot adds people to. Leave it out: at its first start the bot
# uses its one moderation list, or makes one called "Block List"
# (MOD_LIST_NAME to name it), and logs the link to subscribe to it.
# MOD_LIST_URI=

# ---- AI model (optional) -----------------------------------------------------
# With no model, the bot still blocks, unblocks, scans, approves, undoes and
# re-scores weekly. A model adds: questions in plain words, agent mode,
# sorting replies by tone ("hostile"), watching posts, and digests.
#
# Pick ONE provider. If MODEL_PROVIDER is unset it is guessed from the key.
#
#   Vercel AI Gateway   MODEL_PROVIDER=gateway  AI_GATEWAY_API_KEY=...
#   OpenRouter          MODEL_PROVIDER=openrouter  OPENROUTER_API_KEY=...
#   Anthropic           MODEL_PROVIDER=anthropic  ANTHROPIC_API_KEY=...
#   OpenAI              MODEL_PROVIDER=openai  OPENAI_API_KEY=...
#   Anything that speaks the OpenAI API (Ollama, LM Studio, vLLM, Groq,
#   Together, DeepSeek...):
#                       MODEL_PROVIDER=openai-compatible
#                       MODEL_BASE_URL=http://localhost:11434/v1
#                       MODEL_API_KEY=...  (if the server wants one)
#   Under Docker, localhost is the bot's own container. For Ollama on the
#   same machine use http://host.docker.internal:11434/v1, uncomment the
#   extra_hosts line in compose.yaml, and have Ollama listen beyond loopback
#   (OLLAMA_HOST=0.0.0.0) with port 11434 closed to the internet.
#
# On the gateway and OpenRouter the model defaults to
# deepseek/deepseek-v4.1-flash. Everywhere else set MOD_AGENT_MODEL in that
# provider's naming. It must support tool calling.
MODEL_PROVIDER=
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL_BASE_URL=
MODEL_API_KEY=
MOD_AGENT_MODEL=

# Optional. See docs/HOW-IT-WORKS.md, "Models".
# The model that answers the write check in agent mode. Defaults to the
# agent model (MOD_AGENT_MODEL, or the config file's "model").
# MOD_CHECK_MODEL=
# A second model that takes a turn the first one fumbled, and re-reads posts
# labelled hostile.
# MOD_ESCALATION_MODEL=
# Agent mode's reasoning effort: off, minimal, low, medium or high.
# MOD_OPERATOR_REASONING=

# ---- Optional ----------------------------------------------------------------

# "classic": typed commands and numbered menus, a read-only model for
# questions. "agent": talk in sentences; one model holds the write tools
# (every write is still checked, and PROTECTED accounts are still refused).
# MOD_DM_MODE=classic

# Who else the bot answers. DIDs only, comma separated.
# ALLOWED may read (look up, scan, ask questions) but change nothing.
# WRITERS may also add and remove. Empty by default, on purpose.
# MOD_ALLOWED_DIDS=
# MOD_WRITER_DIDS=

# The Atmosphere MCP gives the model read access to the wider network (author
# feeds, threads, search). It is a public service at aturi.to.
# ATMOSPHERE=true
# ATMOSPHERE_URL=https://aturi.to/api/mcp

# Curation lists of yours whose members should NOT be protected (comma
# separated at:// URIs). By default everyone on a curation list you made is
# protected, like everyone you follow.
# MOD_UNPROTECTED_LISTS=

# Re-score the whole list this often and DM you what moved. 0 = never.
# DRIFT_EVERY_HOURS=168

# What the database keeps. Cleared once a day. For the days settings, 0 keeps
# them for good. Anything a change to the list was written from is always
# kept, so history and undo keep working.
# Follow-graph snapshots: the newest is scored against, older ones are spares.
# MOD_KEEP_SNAPSHOTS=2
# Weekly re-scores, a row per account on the list each.
# MOD_KEEP_AUDITS=4
# Scans you never approved anything from.
# MOD_KEEP_UNAPPROVED_DAYS=30
# The words beside a tone label ("hostile: ..."). The label itself stays.
# MOD_KEEP_QUOTES_DAYS=0
# Token counts per model call.
# MOD_KEEP_USAGE_DAYS=90

# Rebuild the follow-graph snapshot when it is older than this.
# SNAPSHOT_MAX_AGE_DAYS=7

# How much of the follow graph to read. "full" reads who you follow and who
# each of them follows (about 550 MB for 2,000 follows). "simple" reads only
# who you follow and treats anyone who follows you as connected: a few MB, but
# friends of friends who don't follow you score as unknown.
# See docs/HOW-IT-WORKS.md, "Simple scoring".
# MOD_SCORING=full

# Watching posts, and offers to watch your own when they take off.
# MOD_WATCH_EVERY_MS=300000
# MOD_ALERTS=true
# MOD_ALERT_THRESHOLD=15

# Where the database and state files live. In Docker this is the mounted volume.
# DATA_DIR=data

# Keep the data in Postgres instead of the SQLite file. The tables go in their
# own schema. See docs/DEPLOY.md, "With your own database".
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_SCHEMA=bluesky_mod

# Optional voice and limits. See config/bot.example.json.
# MOD_CONFIG_FILE=config/bot.json

# true = read no DMs and write nothing: the re-score, watches and alerts are
# off too. It still logs in and builds the snapshot. DMs sent during a dry
# run are answered when it is turned off, list changes included, unless the
# bot has never run live; then they are skipped.
# DRY_RUN=false

# error, warn, info, debug or trace.
# LOG_LEVEL=info
# LOG_JSON=false

# Services. Change only to use your own instances.
# APPVIEW_URL=https://public.api.bsky.app
# CONSTELLATION_URL=https://constellation.microcosm.blue
# JETSTREAM_HOST=jetstream2.us-west.bsky.network
# PLC_DIRECTORY_URL=https://plc.directory
# The bot's PDS, if its DID document cannot be read.
# MOD_SERVICE=
